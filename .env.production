# Variables utilisées par `vite build` (déploiement Vercel / production).
# En local, `npm run dev` utilise .env qui pointe sur http://localhost:3000/api.
# Backend hébergé sur Render (process persistant — le serverless Vercel
# bloquait au démarrage à froid, voir Backend_cyna/render.yaml).
VITE_API_URL=https://backend-cyna.onrender.com/api
